generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseType {
  STRENGTH
  BODYWEIGHT
  CARDIO
  STRETCHING
  MOBILITY
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
  ANIMATION
  TUTORIAL
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         Profile?
  preferences     UserPreferences?
  sessions        WorkoutSession[]
  plans           UserWorkoutPlan[]
  personalRecords PersonalRecord[]
  progressRecords ProgressRecord[]
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  age               Int?
  fitnessLevel      Difficulty?
  primaryGoal       String?
  workoutFrequency  Int?
  preferredDuration Int?
  equipment         String?
  trainingDays      String?
  targetMuscles     String?
  onboardingDone    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  reminderEnabled  Boolean  @default(false)
  reminderTime     String?
  reminderDays     String?
  reducedMotion    Boolean  @default(false)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id              String              @id @default(cuid())
  name            String              @unique
  slug            String              @unique
  description     String
  instructions    String
  commonMistakes  String?
  formTips        String?
  safetyNotes     String?
  difficulty      Difficulty
  type            ExerciseType
  equipment       String
  primaryMuscle   String
  secondaryMuscle String?
  imageUrl        String?
  videoUrl        String?
  defaultSets     Int?
  defaultReps     Int?
  defaultDuration Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workoutExercises WorkoutExercise[]
  completedExercises CompletedExercise[]
  personalRecords PersonalRecord[]
  media           ExerciseMedia[]
  instructionSteps ExerciseInstruction[]
  @@index([primaryMuscle])
  @@index([difficulty, type])
}

model ExerciseMedia {
  id          String    @id @default(cuid())
  exerciseId  String
  type        MediaType
  url         String
  thumbnailUrl String?
  title       String?
  description String?
  source      String?
  sourceUrl   String?
  duration    Int?
  sortOrder   Int       @default(0)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@index([exerciseId, sortOrder])
}

model ExerciseInstruction {
  id         String   @id @default(cuid())
  exerciseId String
  step       Int
  title      String?
  body       String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([exerciseId, step])
}

model WorkoutProgram {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  goal        String
  difficulty  Difficulty
  duration    Int
  weeks       Int
  daysPerWeek Int
  equipment   String
  published   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workouts    Workout[]
  plans       UserWorkoutPlan[]
}

model Workout {
  id          String           @id @default(cuid())
  programId   String?
  name        String
  slug        String           @unique
  description String
  dayNumber   Int
  duration    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  program     WorkoutProgram?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises   WorkoutExercise[]
  sessions    WorkoutSession[]
  @@index([programId, dayNumber])
}

model WorkoutExercise {
  id          String   @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int
  sets        Int
  reps        Int?
  duration    Int?
  restSeconds Int      @default(90)
  notes       String?
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  @@unique([workoutId, order])
  @@index([exerciseId])
}

model UserWorkoutPlan {
  id        String         @id @default(cuid())
  userId    String
  programId String
  startedAt DateTime       @default(now())
  active    Boolean        @default(true)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@unique([userId, programId])
}

model WorkoutSession {
  id              String              @id @default(cuid())
  userId          String
  workoutId       String
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  notes           String?
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout             @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  exercises       CompletedExercise[]
  @@index([userId, startedAt])
}

model CompletedExercise {
  id          String          @id @default(cuid())
  sessionId   String
  exerciseId  String
  order       Int
  completedAt DateTime?
  session     WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise    Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets        CompletedSet[]
  @@unique([sessionId, order])
}

model CompletedSet {
  id                  String            @id @default(cuid())
  completedExerciseId String
  setNumber           Int
  weight              Float?
  reps                Int?
  durationSeconds     Int?
  restSeconds         Int?
  completedAt         DateTime          @default(now())
  notes               String?
  exercise            CompletedExercise @relation(fields: [completedExerciseId], references: [id], onDelete: Cascade)
  @@unique([completedExerciseId, setNumber])
}

model ProgressRecord {
  id        String   @id @default(cuid())
  userId    String
  metric    String
  value     Float
  unit      String
  recordedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, metric, recordedAt])
}

model PersonalRecord {
  id         String    @id @default(cuid())
  userId     String
  exerciseId String?
  metric     String
  value      Float
  unit       String
  achievedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  @@index([userId, metric])
}
